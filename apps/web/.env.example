DATABASE_URL="mysql://root:your_password_here@localhost:3306/capevars"
ADMIN_SESSION_SECRET=
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# File storage. "local" (default): uploads live on this server under STORAGE_DIR
# and are served from /files with CDN-grade caching. "r2": Cloudflare R2 below.
STORAGE_DRIVER=local
# Defaults to apps/web/storage. In production use an absolute path outside the
# release folder (e.g. /var/lib/capevars/storage) so deploys never touch it.
STORAGE_DIR=
# Optional: signs upload URLs (falls back to ADMIN_SESSION_SECRET).
STORAGE_SIGNING_SECRET=
# Lets `npm run storage:push -- <url>` copy uploads into this server. Use the
# same value (at least 32 characters) on the machine you push from. Leave empty to disable.
STORAGE_SYNC_TOKEN=
# Optional CDN (e.g. Cloudflare proxying this site on cdn.yourdomain.com).
# /files and /img URLs are pointed at it when pages render; rebuild after changing.
CDN_URL=
# Set to false to skip pre-rendering common image sizes right after upload.
IMAGE_PREWARM=

# Cloudflare R2, used when STORAGE_DRIVER=r2 (same bucket/credentials as akaweb;
# capevars uploads live under capevars/). Files already in R2 keep working after a switch.
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=akatsico
R2_PUBLIC_DOMAIN=https://pub-e59a232a590b4e31a152ca4e1aa48a37.r2.dev
R2_KEY_PREFIX=capevars

IMAGE_CACHE_DIR=
IMAGE_REMOTE_HOSTS=picsum.photos,fastly.picsum.photos,lh3.googleusercontent.com
IMAGE_CONCURRENCY=
VITE_IMAGE_OPTIMIZATION=

# Google sign-in for members. Add {APP_URL}/api/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Online payments (optional). Without a key, orders are pay-on-delivery / MoMo-direct
# and organisers confirm payment manually.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# LeadGen SMS broadcasts via SMSOnlineGH (https://dev.smsonlinegh.com). Every
# sender ID must also be registered in your SMSOnlineGH account.
SMSONLINEGH_API_KEY=
# LeadGen email broadcasts via Gmail (Nodemailer). Use a Google account with
# 2-step verification and an App Password (Google Account → Security → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Development only: pretend to send SMS/email when the keys above are empty.
MESSAGING_SIMULATE=true
